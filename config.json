{
  "title": "NYC Department of Investigation Enforcement Actions",
  "headline": "A decade of NYC Department of Investigation cases, sorted by what people were accused of",
  "description": "Every DOI press release from 2016 to 2026, tagged by offense category, case stage, and dollars stolen and recovered.",
  "site_url": "https://bnmont.github.io/nycdoi",
  "source_name": "NYC Department of Investigation press release archive",
  "source_url": "https://www.nyc.gov/site/doi/newsroom/press-release-archives.page",
  "method_note": "Each row is one DOI press release, not one defendant: a release naming five people counts once. Categories are assigned by matching the phrases in the rulebook below against the release title, first match winning, so a case charging both bribery and fraud is filed under bribery alone. Dollar figures are read out of the release PDF and are reported only when the surrounding words identify them as an amount stolen or recovered; salary figures, which DOI states in most enforcement releases, are excluded. Many releases state no figure at all, so the dollar columns are incomplete by nature and should never be summed as a total loss to the city. DOI reports, statements, announcements and press-conference remarks are kept in the data but marked as such, because they are not enforcement actions.",
  "author": "Brittany Montgomery",
  "accent": "#14366b",

  "years_back": 10,
  "refresh_months": 3,

  "label_column": "category",
  "value_column": "releases",

  "_comment_record_types": "Checked before categories. Anything unmatched is treated as an enforcement action, so these rules must be specific enough not to swallow one. Note that 'DOI Investigation Leads to Arrest of...' is an enforcement action, which is why no rule here matches the bare word 'investigation'.",
  "record_types": [
    {"name": "Commissioner remarks", "keywords": ["remarks of", "remarks at", "testimony of", "speech by", "marks first day"]},
    {"name": "Agency announcement", "keywords": ["appoints", "launches", "year-end statistics", "yearend", "by the numbers", "closes out", "legislature passes", "notice of intent", "begins review", "letter to new york city council", "letter to the new york city council", "public portal"]},
    {"name": "DOI report", "keywords": ["issues report", "issues two reports", "issues its", "doi report", "report on", "report finding", "report examines", "an analysis of", "recommendations to", "recommendations for", "annual report", "statement of findings", "examination finds", "finds flaws", "finds compliance", "releases investigation report", "releases final investigation", "releases results of investigation", "doi's investigation into", "doi referral"]},
    {"name": "DOI statement", "keywords": ["doi statement", "statement from doi", "statement of doi", "commissioner statement", "department of investigation statement", "updates the public", "release statement"]}
  ],

